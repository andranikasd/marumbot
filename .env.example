# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- required -----------------------------------------------------------
MARUM_BOT_TOKEN=                 # from @BotFather; use a separate dev bot

# --- local defaults -----------------------------------------------------
MARUM_ENV=dev
MARUM_MODE=polling               # polling locally, webhook in production
MARUM_DEFAULT_CURRENCY=AMD
MARUM_DEFAULT_TZ=Asia/Yerevan
MARUM_TICK_INTERVAL=60

# --- private admin interface --------------------------------------------
# Without MARUM_ADMIN_PASSWORD_HASH the admin listener stays down rather than
# coming up unauthenticated. Generate with: make admin-password
MARUM_ADMIN_USER=admin
MARUM_ADMIN_PASSWORD_HASH=
MARUM_ADMIN_TOTP_SECRET=

# --- identity ------------------------------------------------------------
# Seals Telegram identifiers at rest. Without it the service refuses to start,
# because running without it would store them in the clear.
#   openssl rand -base64 32
MARUM_IDENTITY_KEY=

# Proves a request reached the container through the Cloudflare Worker rather
# than directly. Unset locally, where there is no Worker.
MARUM_SERVICE_TOKEN=

# Absolute https URL of the loan form. Telegram will not open a web_app button
# without one, so /add falls back to an error when this is empty.
MARUM_MINIAPP_URL=

# --- observability ------------------------------------------------------
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable telemetry entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=      # Authorization=Basic <base64(instanceID:token)>
OTEL_SERVICE_NAME=marum
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev,service.namespace=marum
PYROSCOPE_SERVER_ADDRESS=
PYROSCOPE_BASIC_AUTH_USER=
PYROSCOPE_BASIC_AUTH_PASSWORD=
