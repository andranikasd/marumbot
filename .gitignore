.env
docs/design/marum-final.render.html

# Terraform: provider binaries, local state, and any real variable values.
# .terraform.lock.hcl IS committed -- it pins provider versions across machines.
deploy/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.auto.tfvars

# Neon: `neon link` writes org, project and branch IDs here, and pulls env into
# .env alongside it.
.neon

# Agent skill bodies are vendored third-party content, reinstallable from
# skills-lock.json with `npx skills add`. The lock file IS committed, for the
# same reason .terraform.lock.hcl is: so everyone resolves the same version.
.agents/
.claude/skills/
