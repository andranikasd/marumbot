<mxfile>
  <diagram id="seqlayout" name="Durable inbound path">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="tg" value="Telegram" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="100" height="840" as="geometry"/>
        </mxCell>
        <mxCell id="w" value="Webhook" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="100" height="840" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="100" height="840" as="geometry"/>
        </mxCell>
        <mxCell id="c" value="Command worker" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="100" height="840" as="geometry"/>
        </mxCell>
        <mxCell id="s" value="Sender" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="840" y="40" width="100" height="840" as="geometry"/>
        </mxCell>
        <mxCell id="act0" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="db">
          <mxGeometry x="45" y="210" width="10" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="act1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="w">
          <mxGeometry x="45" y="90" width="10" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="act2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="db">
          <mxGeometry x="45" y="420" width="10" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="act3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="tg">
          <mxGeometry x="45" y="700" width="10" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="update (secret-token header)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1071;entryX=0;entryY=0.0;" edge="1" parent="1" source="tg" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="validate, bound, normalise to a command" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.2273;entryX=1;entryY=0.3636;" edge="1" parent="1" source="act1" target="act1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="350" y="180"/><mxPoint x="350" y="210"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="INSERT ON CONFLICT (telegram_update_id) DO NOTHING" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.5455;entryX=0;entryY=0.0;" edge="1" parent="1" source="act1" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="commit" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.7727;" edge="1" parent="1" source="act0" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="200 OK — only after durable commit" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.369;" edge="1" parent="1" source="act1" target="tg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note5" value="Crash before this point: Telegram retries. Crash after: the command is already durable." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="310" y="380" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="lease command (fencing token)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.5;entryX=1;entryY=0.0;" edge="1" parent="1" source="c" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="apply effect: event, allocation, state, occurrences" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.5595;entryX=0.5;entryY=0.5952;" edge="1" parent="1" source="c" target="c">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="750" y="510"/><mxPoint x="750" y="540"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="one transaction; complete command with the same token" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.6429;entryX=1;entryY=0.3158;" edge="1" parent="1" source="c" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note9" value="No Telegram call inside this transaction (R8)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="710" y="610" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="claim reply delivery" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.7738;entryX=1;entryY=0.6053;" edge="1" parent="1" source="s" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="sendMessage" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.8333;entryX=1;entryY=0.0;" edge="1" parent="1" source="s" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m12" value="mark sent + message_id" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.8929;entryX=1;entryY=0.8684;" edge="1" parent="1" source="s" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
