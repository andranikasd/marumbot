      "title": "Traces",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "table",
      "title": "Slowest recent traces",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "tempo",
        "uid": "${ds_tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && duration > 5ms}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "description": "Click a trace ID to open the waterfall. Each span links to its logs and to a CPU profile."
    },
    {
      "id": 21,
      "type": "nodeGraph",
      "title": "Service graph",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "datasource": {
        "type": "tempo",
        "uid": "${ds_tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "serviceMap"
        }
      ],
      "description": "Built from span metrics: what calls what, and how often it fails."
    },
    {
      "id": 500,
      "type": "row",
      "title": "Inside the monolith",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "panels": [],
      "description": "Marum is one deployable but several independent pieces of work. A service graph keyed on service name shows one node; these panels read each piece separately."
    },
