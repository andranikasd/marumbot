    {
      "id": 503,
      "type": "table",
      "title": "Component health",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum by (marum_component) (rate(traces_spanmetrics_calls_total{service=\"$service\"}[$__range]))"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum by (marum_component) (rate(traces_spanmetrics_calls_total{service=\"$service\",status_code=\"STATUS_CODE_ERROR\"}[$__range]))"
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, marum_component) (rate(traces_spanmetrics_latency_bucket{service=\"$service\"}[$__range])))"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "marum_component",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "marum_component": "Component",
              "Value #A": "Calls / sec",
              "Value #B": "Errors / sec",
              "Value #C": "p99"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Errors / sec"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 0.001
                    }
                  ]
                }
              }
