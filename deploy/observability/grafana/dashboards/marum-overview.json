        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "sum(increase(marum_accrual_overflow_total{service_name=\"$service\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
