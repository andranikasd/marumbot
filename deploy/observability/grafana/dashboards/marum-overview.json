{
  "uid": "marum-overview",
  "title": "Marum \u00b7 Overview",
  "tags": [
    "marum",
    "correlation"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 2,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "ds_prometheus",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "/^(Prometheus|grafanacloud-.*-prom)$/",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 2,
        "includeAll": false,
        "label": "Loki",
        "multi": false,
        "name": "ds_loki",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "regex": "/^(Loki|grafanacloud-.*-logs)$/",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 2,
        "includeAll": false,
        "label": "Tempo",
        "multi": false,
        "name": "ds_tempo",
        "options": [],
        "query": "tempo",
        "refresh": 1,
        "regex": "/^(Tempo|grafanacloud-.*-traces)$/",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "refresh": 1,
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, service_name)",
          "refId": "A"
        },
        "current": {
          "text": "marum",
          "value": "marum"
        },
        "includeAll": false
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Log filter",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "links": [
    {
      "title": "Explore traces",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22:%22marum-tempo%22%7D",
      "icon": "external link"
    },
    {
      "title": "Explore profiles",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22:%22marum-pyroscope%22%7D",
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Golden signals",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / sec",
      "description": null,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors / sec",
      "description": null,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\",http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 latency",
      "description": null,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"$service\"}[$__rate_interval])))",
          "legendFormat": "",
          "refId": "A",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
