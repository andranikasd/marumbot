# Copy to deploy/vps/.env, chmod 600. Use fresh secrets; never commit .env.
# Passwords below must be hexadecimal (openssl rand -hex 32), because they
# are interpolated into PostgreSQL keyword DSNs.
POSTGRES_PASSWORD=
MARUM_DB_PASSWORD=
MARUM_SERVICE_TOKEN=
# openssl rand -base64 32; preserve the EXISTING key when importing data.
MARUM_IDENTITY_KEY=
MARUM_BOT_TOKEN=
MARUM_DOMAIN=
ACME_EMAIL=
# Release tag or commit; build stamps and image tags use this value.
MARUM_VERSION=
# Optional admin login. Single-quote the hash to preserve literal dollar signs.
MARUM_ADMIN_PASSWORD_HASH=''
MARUM_ADMIN_USER=admin

# Initial envelope for an 8 vCPU / 24 GB / 200 GB NVMe VPS; adjust from measured load.
MARUM_PG_MEMORY=8g
MARUM_PG_CPUS=2
MARUM_PG_SHM_SIZE=1g
MARUM_PG_MAX_CONNECTIONS=60
MARUM_PG_SHARED_BUFFERS=2GB
MARUM_PG_EFFECTIVE_CACHE_SIZE=6GB
MARUM_PG_WORK_MEM=8MB
MARUM_PG_MAINTENANCE_WORK_MEM=512MB
MARUM_APP_MEMORY=6g
MARUM_APP_CPUS=4
MARUM_GOMEMLIMIT=4GiB
MARUM_GOMAXPROCS=4
MARUM_POOL_MAX_CONNS=16
MARUM_POOL_MIN_CONNS=2

# Optional registry image@sha256:... overrides. PG/Caddy defaults are pinned;
# application defaults are local builds. For registry releases, pull and start with --no-build.
# The migration image must contain the matching Goose binary; migrations are
# mounted from this checkout, so deploy the matching release checkout too.
MARUM_IMAGE=
MARUM_MIGRATE_IMAGE=
MARUM_POSTGRES_IMAGE=
MARUM_CADDY_IMAGE=

# Backup scripts read these from the exported backup-service environment,
# not automatically from Compose's .env. Set them in /etc/marum/backup.env.
# Shared by manual and scheduled offsite runs; use a host-local path.
MARUM_BACKUP_LOCK=/run/lock/marum-backup.lock
MARUM_BACKUP_RETENTION_DAYS=14
MARUM_RESTIC_KEEP_DAILY=14
MARUM_RESTIC_KEEP_WEEKLY=8
MARUM_RESTIC_KEEP_MONTHLY=12

# Required independent journal; provision chmod0700, owner65532 before startup.
# Restore its latest authoritative contents before restoring borrower access.
MARUM_ERASURE_JOURNAL_DIR=/var/lib/marum/erasures

# Existing exporters; configure the destination before live launch.
# Use the provider's OTLP HTTP base URL and URL-encoded header values.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
PYROSCOPE_SERVER_ADDRESS=
PYROSCOPE_BASIC_AUTH_USER=
PYROSCOPE_BASIC_AUTH_PASSWORD=
