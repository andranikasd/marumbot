[Unit]
Description=Marum PostgreSQL dump and encrypted offsite backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/marum/backup.env
ExecStart=/bin/sh /opt/marum/deploy/vps/backup-offsite.sh
UMask=0077
Nice=10
TimeoutStartSec=1h
